{
  "name": "katsana/minions-polyfill",
  "description": "Minions Component Server (Polyfill) using Laravel Routing",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "KATSANA Developer",
      "email": "developer@katsana.com"
    },
    {
      "name": "Mior Muhammad Zaki",
      "email": "crynobone@katsana.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Minions\\Polyfill\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Minions\\Polyfill\\Tests\\": "tests/"
    }
  },
  "require": {
    "illuminate/http": "^9.0",
    "katsana/minions": "3.x-dev"
  },
  "require-dev": {
    "clue/block-react": "^1.3",
    "orchestra/canvas": "^7.0",
    "orchestra/testbench-dusk": "^7.0"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.1-dev"
    },
    "laravel": {
      "providers": [
        "Minions\\Polyfill\\MinionsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/maxerism/minions"
    }
  ]
}
